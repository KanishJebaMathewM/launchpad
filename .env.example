VITE_FAAS_URL=http://localhost:9000
VITE_FAAS_TOKEN=faas_token

# Optional. When empty, login and signup requests are proxied through the
# Vite dev server to dashboard.metacall.io (the default behaviour).
# Set to a full URL (e.g. https://auth.example.com) to bypass the proxy
# and call that endpoint directly from the browser.
VITE_AUTH_URL=

VITE_TURNSTILE_SITE_KEY=