{
  "name": "@metacall/launchpad",
  "version": "0.1.0",
  "description": "MetaCall Launchpad dashboard for a local MetaCall FaaS, as a command line tool.",
  "main": "dist/index.js",
  "bin": {
    "metacall-launchpad": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "build": "node scripts/bundle-ui.mjs && tsc",
    "build:server": "tsc",
    "test": "npm run build:server && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metacall/launchpad.git",
    "directory": "cli"
  },
  "keywords": [
    "MetaCall",
    "FaaS",
    "Launchpad",
    "dashboard"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/metacall/launchpad/issues"
  },
  "homepage": "https://github.com/metacall/launchpad/tree/master/cli#readme",
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^18.19.130",
    "typescript": "~5.9.3"
  }
}
