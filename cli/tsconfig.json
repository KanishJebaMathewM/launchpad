{
  "compilerOptions": {
    "strict": true,
    "lib": ["es2020"],
    "types": ["node"],
    "moduleResolution": "node",
    "target": "es2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
